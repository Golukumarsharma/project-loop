generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  feedbacks Feedback[]
  reports   Report[]
  themes    Theme[]
  users     User[]
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String
  role        Role
  workspaceId String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model Feedback {
  id          String          @id @default(cuid())
  title       String
  description String
  sentiment   String?
  status      String          @default("NEW")
  workspaceId String
  createdAt   DateTime        @default(now())
  embedding   Embedding?
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  themes      FeedbackTheme[]
}

model Theme {
  id          String          @id @default(cuid())
  name        String
  workspaceId String
  createdAt   DateTime        @default(now())
  feedbacks   FeedbackTheme[]
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
}

model FeedbackTheme {
  id         String   @id @default(cuid())
  feedbackId String
  themeId    String
  confidence Float
  feedback   Feedback @relation(fields: [feedbackId], references: [id])
  theme      Theme    @relation(fields: [themeId], references: [id])
}

model Embedding {
  id         String   @id @default(cuid())
  feedbackId String   @unique
  vector     Json
  feedback   Feedback @relation(fields: [feedbackId], references: [id])
}

model Report {
  id          String    @id @default(cuid())
  title       String
  content     String
  workspaceId String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}
